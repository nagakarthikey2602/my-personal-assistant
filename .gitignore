# Local runtime state -- never commit
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
models/*
!models/.gitkeep
!models/intent_model.json
!models/intent_eval.json
!models/intent_metrics.json
!models/intent_model_card.md
training_data/*
!training_data/.gitkeep
!training_data/generated/
!training_data/generated/**
config/config.yaml
config/installed_components.json
sandbox/*
!sandbox/.gitkeep
backups/
*.wav
*.pcm
*.db
*.db-wal
*.db-shm
.env
secrets/

# Local tooling
.idea/
.vscode/
*.spec
!packaging/personal_assistant.spec
